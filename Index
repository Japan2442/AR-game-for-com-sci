<script>
/* =========================================================================
   AR TYPE SORT — จับคู่ค่า/โจทย์บรรยาย กับชนิดข้อมูลภาษา C
   Single-file game. MediaPipe Hands for pinch-drag, mouse/touch fallback.
   ========================================================================= */

/* ---------------- DATA: 10 rounds, categories, items ---------------- */
// Categories = drop bins. Keep to a workable set so bins fit on screen;
// items are drawn from a wider pool covering all of them (>=1 item per category).
const CATEGORIES = [
  { id:'int',    label:'int',    sub:'จำนวนเต็ม',        color:'#22D3EE' },
  { id:'float',  label:'float',  sub:'ทศนิยม',           color:'#FBBF24' },
  { id:'char',   label:'char',   sub:'อักขระ 1 ตัว',     color:'#34D399' },
  { id:'string', label:'string', sub:'ข้อความ (char[])', color:'#FB7185' },
  { id:'bool',   label:'bool',   sub:'จริง/เท็จ',        color:'#A78BFA' },
];

// Pool of 10 rounds — mixed: literal C code values + plain-language prompts.
const ROUND_POOL = [
  { display: '1',            mono:true,  correct:'int' },
  { display: "'A'",          mono:true,  correct:'char' },
  { display: '"Apple"',      mono:true,  correct:'string' },
  { display: '3.14',         mono:true,  correct:'float' },
  { display: 'true',         mono:true,  correct:'bool' },
  { display: 'อายุของคน (เช่น 15 ปี)',        mono:false, correct:'int' },
  { display: 'เกรดวิชา (A, B, C, D, F)',       mono:false, correct:'char' },
  { display: 'ชื่อ-นามสกุลนักเรียน',           mono:false, correct:'string' },
  { display: 'ส่วนสูง 168.50 ซม.',            mono:false, correct:'float' },
  { display: 'สถานะ "มาเรียนวันนี้หรือไม่"',   mono:false, correct:'bool' },
  { display: '0',             mono:true,  correct:'int' },
  { display: "'x'",           mono:true,  correct:'char' },
  { display: '"Bangkok"',     mono:true,  correct:'string' },
  { display: '99.9',          mono:true,  correct:'float' },
  { display: 'false',         mono:true,  correct:'bool' },
  { display: 'จำนวนนักเรียนในห้อง',           mono:false, correct:'int' },
  { display: 'ตัวอักษรตัวแรกของชื่อ',          mono:false, correct:'char' },
  { display: 'ที่อยู่บ้านเลขที่ ถนน ตำบล',      mono:false, correct:'string' },
  { display: 'อุณหภูมิ 36.6 องศา',            mono:false, correct:'float' },
  { display: 'ไฟเขียว = เดินได้ (ใช่/ไม่ใช่)', mono:false, correct:'bool' },
];

function shuffle(arr){
  const a = arr.slice();
  for(let i=a.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    [a[i],a[j]] = [a[j],a[i]];
  }
  return a;
}

let rounds = [];       // the 10 chosen for this playthrough
let roundIndex = 0;
let score = 0;
let correctCount = 0;
let wrongAttempts = 0;

/* ---------------- Canvas + layout ---------------- */
const gameCanvas = document.getElementById('gameCanvas');
const gctx = gameCanvas.getContext('2d');
const handCanvas = document.getElementById('handCanvas');
const hctx = handCanvas.getContext('2d');

function resizeCanvases(){
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  [gameCanvas, handCanvas].forEach(c=>{
    c.width = innerWidth * dpr;
    c.height = innerHeight * dpr;
    c.style.width = innerWidth + 'px';
    c.style.height = innerHeight + 'px';
    const ctx = c.getContext('2d');
    ctx.setTransform(dpr,0,0,dpr,0,0);
  });
  layoutBins();
}
window.addEventListener('resize', resizeCanvases);

/* ---------------- Bins (drop zones) ---------------- */
let bins = [];
function layoutBins(){
  const W = innerWidth, H = innerHeight;
  const isNarrow = W < 640;
  const cols = isNarrow ? Math.min(3, CATEGORIES.length) : CATEGORIES.length;
  const rowsNeeded = Math.ceil(CATEGORIES.length / cols);
  const margin = isNarrow ? 10 : 24;
  const gap = isNarrow ? 8 : 14;
  const trayH = isNarrow ? (rowsNeeded===2 ? 128 : 78) : 96;
  const binW = (W - margin*2 - gap*(cols-1)) / cols;
  const binH = rowsNeeded===2 ? (trayH-gap)/2 : trayH;

  bins = CATEGORIES.map((cat, i)=>{
    const col = i % cols;
    const row = Math.floor(i / cols);
    const x = margin + col*(binW+gap);
    const y = H - trayH - (isNarrow?10:22) + row*(binH+gap);
    return { ...cat, x, y, w:binW, h:binH, flashUntil:0, flashColor:null };
  });
}

/* ---------------- Floating item (the draggable chip) ---------------- */
let item = null; // { data, x, y, vx, vy, w, h, dragging, angle }

function spawnItem(){
  const data = rounds[roundIndex];
  const W = innerWidth, H = innerHeight;
  const isMono = data.mono;
  gctx.font = `${isMono?600:600} ${isMono?22:16}px ${isMono?"'JetBrains Mono'":"'Space Grotesk'"}`;
  const textW = gctx.measureText(data.display).width;
  const padX = 28, padY = 20;
  const w = Math.min(Math.max(textW + padX*2, 120), W*0.82);
  const h = 58;

  item = {
    data, x: W/2, y: Math.max(150, H*0.32),
    vx: (Math.random()-0.5)*10, vy: -8 - Math.random()*6,
    w, h, dragging:false, angle:0, floatSeed: Math.random()*1000,
    grabDX:0, grabDY:0
  };
}

function updatePrompt(){
  const cat = CATEGORIES.find(c=>c.id===rounds[roundIndex].correct);
  document.getElementById('promptText').textContent =
    `วางลงในหมวด "${cat.label}" — ${cat.sub}`;
  document.getElementById('hudProgress').textContent = roundIndex+1;
}

/* ---------------- Pointer state (hand only — mouse/touch removed) ---------------- */
const pointer = { x: innerWidth/2, y: innerHeight/2, active:false, pinching:false, prevPinching:false, source:'hand' };
let usingHandTracking = false;

/* ---------------- Toast ---------------- */
let toastTimer=null;
function showToast(icon, text, tone){
  const el = document.getElementById('toast');
  document.getElementById('toastIcon').textContent = icon;
  const txt = document.getElementById('toastText');
  txt.textContent = text;
  txt.style.color = tone==='good' ? 'var(--green)' : tone==='bad' ? 'var(--rose)' : 'var(--ink)';
  el.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=> el.classList.remove('show'), 1400);
}

/* ---------------- Game loop ---------------- */
let lastTime = performance.now();
let particles = [];

function spawnParticles(x,y,color,n=18){
  for(let i=0;i<n;i++){
    const a = Math.random()*Math.PI*2;
    const sp = 2+Math.random()*5;
    particles.push({
      x,y, vx:Math.cos(a)*sp, vy:Math.sin(a)*sp - 2,
      life:1, color, size: 3+Math.random()*3
    });
  }
}

function roundRect(ctx,x,y,w,h,r){
  ctx.beginPath();
  ctx.moveTo(x+r,y);
  ctx.arcTo(x+w,y,x+w,y+h,r);
  ctx.arcTo(x+w,y+h,x,y+h,r);
  ctx.arcTo(x,y+h,x,y,r);
  ctx.arcTo(x,y,x+w,y,r);
  ctx.closePath();
}

function drawBins(){
  const now = performance.now();
  bins.forEach(b=>{
    const flashing = now < b.flashUntil;
    gctx.save();
    roundRect(gctx, b.x, b.y, b.w, b.h, 16);
    gctx.fillStyle = flashing ? hexAlpha(b.flashColor, 0.35) : 'rgba(255,255,255,0.055)';
    gctx.fill();
    gctx.lineWidth = flashing ? 3 : 1.5;
    gctx.strokeStyle = flashing ? b.flashColor : hexAlpha(b.color, 0.55);
    gctx.stroke();
    gctx.restore();

    const cx = b.x + b.w/2, cy = b.y + b.h/2;
    gctx.textAlign='center'; gctx.textBaseline='middle';
    gctx.fillStyle = b.color;
    gctx.font = "700 " + (b.h<70? "16px":"19px") + " 'JetBrains Mono'";
    gctx.fillText(b.label, cx, cy - (b.h<70?7:9));
    gctx.fillStyle = 'rgba(231,236,245,0.65)';
    gctx.font = (b.h<70? "9px":"10.5px") + " 'Space Grotesk'";
    gctx.fillText(b.sub, cx, cy + (b.h<70?9:12));
  });
}

function hexAlpha(hex, a){
  const h = hex.replace('#','');
  const r = parseInt(h.substring(0,2),16), g=parseInt(h.substring(2,4),16), bl=parseInt(h.substring(4,6),16);
  return `rgba(${r},${g},${bl},${a})`;
}

function drawItem(dt){
  if(!item) return;
  const isMono = item.data.mono;

  if(!item.dragging){
    // gentle floaty physics settle to a hover point
    item.vy += 0.15; // gravity-ish pull back toward float band
    const floatY = Math.max(150, innerHeight*0.32) + Math.sin((performance.now()/650)+item.floatSeed)*10;
    item.vy += (floatY - item.y) * 0.004;
    item.vx *= 0.94; item.vy *= 0.94;
    item.x += item.vx; item.y += item.vy;
    item.angle = Math.sin(performance.now()/900+item.floatSeed)*0.03;

    const margin = item.w/2+10;
    if(item.x < margin){ item.x=margin; item.vx*=-0.4; }
    if(item.x > innerWidth-margin){ item.x=innerWidth-margin; item.vx*=-0.4; }
  } else {
    item.angle = (pointer.x - item.x) * 0.0008;
  }

  gctx.save();
  gctx.translate(item.x, item.y);
  gctx.rotate(item.angle);

  const w = item.w, h = item.h;
  const glow = item.dragging ? 26 : 10;
  gctx.shadowColor = item.dragging ? 'rgba(251,191,36,0.65)' : 'rgba(34,211,238,0.35)';
  gctx.shadowBlur = glow;

  roundRect(gctx, -w/2, -h/2, w, h, 18);
  gctx.fillStyle = item.dragging ? 'rgba(251,191,36,0.16)' : 'rgba(255,255,255,0.09)';
  gctx.fill();
  gctx.lineWidth = item.dragging ? 2.5 : 1.5;
  gctx.strokeStyle = item.dragging ? '#FBBF24' : 'rgba(255,255,255,0.35)';
  gctx.stroke();
  gctx.shadowBlur = 0;

  gctx.textAlign='center'; gctx.textBaseline='middle';
  gctx.fillStyle = '#E7ECF5';
  gctx.font = `${isMono?'700':'600'} ${isMono?22:15}px ${isMono?"'JetBrains Mono'":"'Space Grotesk'"}`;
  // wrap long descriptive text
  wrapText(gctx, item.data.display, 0, 0, w-36, isMono?24:18);
  gctx.restore();
}

function wrapText(ctx, text, cx, cy, maxWidth, lineHeight){
  const words = text.split(' ');
  let lines = [];
  let cur = '';
  words.forEach(word=>{
    const test = cur ? cur+' '+word : word;
    if(ctx.measureText(test).width > maxWidth && cur){
      lines.push(cur); cur = word;
    } else cur = test;
  });
  if(cur) lines.push(cur);
  if(lines.length===1){
    ctx.fillText(lines[0], cx, cy);
  } else {
    const totalH = (lines.length-1)*lineHeight;
    lines.forEach((l,i)=> ctx.fillText(l, cx, cy - totalH/2 + i*lineHeight));
  }
}

function drawParticles(dt){
  particles.forEach(p=>{
    p.x += p.vx; p.y += p.vy; p.vy += 0.15; p.life -= 0.02;
    gctx.globalAlpha = Math.max(p.life,0);
    gctx.fillStyle = p.color;
    gctx.beginPath();
    gctx.arc(p.x, p.y, p.size, 0, Math.PI*2);
    gctx.fill();
  });
  gctx.globalAlpha = 1;
  particles = particles.filter(p=>p.life>0);
}

function drawCursor(){
  if(!pointer.active) return;
  gctx.save();
  gctx.beginPath();
  const r = pointer.pinching ? 13 : 16;
  gctx.arc(pointer.x, pointer.y, r, 0, Math.PI*2);
  gctx.fillStyle = pointer.pinching ? 'rgba(251,191,36,0.28)' : 'rgba(34,211,238,0.2)';
  gctx.fill();
  gctx.lineWidth = 2.5;
  gctx.strokeStyle = pointer.pinching ? '#FBBF24' : '#22D3EE';
  gctx.stroke();
  gctx.beginPath();
  gctx.arc(pointer.x, pointer.y, 2.5, 0, Math.PI*2);
  gctx.fillStyle = pointer.pinching ? '#FBBF24' : '#22D3EE';
  gctx.fill();
  gctx.restore();
}

function binAt(x,y){
  return bins.find(b => x>=b.x && x<=b.x+b.w && y>=b.y && y<=b.y+b.h);
}

function pointInItem(x,y){
  if(!item) return false;
  return Math.abs(x-item.x) < item.w/2 && Math.abs(y-item.y) < item.h/2;
}

function handleDragLogic(){
  const justPinched = pointer.pinching && !pointer.prevPinching;
  const justReleased = !pointer.pinching && pointer.prevPinching;

  if(justPinched && item && !item.dragging){
    if(pointInItem(pointer.x, pointer.y)){
      item.dragging = true;
      item.grabDX = pointer.x - item.x;
      item.grabDY = pointer.y - item.y;
      item.vx = 0; item.vy = 0;
    }
  }

  if(item && item.dragging){
    item.x = pointer.x - item.grabDX;
    item.y = pointer.y - item.grabDY;
  }

  if(justReleased && item && item.dragging){
    item.dragging = false;
    const hitBin = binAt(pointer.x, pointer.y) || binAt(item.x, item.y);
    if(hitBin){
      evaluateDrop(hitBin);
    } else {
      item.vy = -4; item.vx = (Math.random()-0.5)*4;
    }
  }

  pointer.prevPinching = pointer.pinching;
}

function evaluateDrop(bin){
  const correct = bin.id === item.data.correct;
  bin.flashUntil = performance.now() + 420;
  bin.flashColor = correct ? '#34D399' : '#FB7185';

  if(correct){
    score += 10;
    correctCount++;
    spawnParticles(item.x, item.y, CATEGORIES.find(c=>c.id===bin.id).color, 22);
    showToast('✅', `ถูกต้อง! ${bin.label} +10`, 'good');
    item = null;
    document.getElementById('hudScore').textContent = score;
    roundIndex++;
    if(roundIndex >= rounds.length){
      setTimeout(endGame, 650);
    } else {
      setTimeout(()=>{ spawnItem(); updatePrompt(); }, 500);
    }
  } else {
    wrongAttempts++;
    spawnParticles(item.x, item.y, '#FB7185', 14);
    showToast('❌', 'ยังไม่ถูก ลองหมวดอื่นดูนะ', 'bad');
    // bounce item back up
    item.x = innerWidth/2;
    item.y = Math.max(150, innerHeight*0.32);
    item.vx = (Math.random()-0.5)*6;
    item.vy = -6;
  }
}

function gameLoop(t){
  const dt = t - lastTime; lastTime = t;
  gctx.clearRect(0,0,innerWidth,innerHeight);

  if(gameActive){
    handleDragLogic();
    drawBins();
    drawParticles(dt);
    drawItem(dt);
    drawCursor();
  }
  requestAnimationFrame(gameLoop);
}
requestAnimationFrame(gameLoop);

/* ---------------- Game state machine ---------------- */
let gameActive = false;

function startPlaythrough(){
  rounds = shuffle(ROUND_POOL).slice(0,10);
  roundIndex = 0; score = 0; correctCount = 0; wrongAttempts = 0;
  document.getElementById('hudScore').textContent = '0';
  layoutBins();
  spawnItem();
  updatePrompt();
  gameActive = true;
  document.getElementById('hud').classList.remove('hidden');
  setTimeout(()=>{
    document.getElementById('hintBanner').style.opacity = '0';
  }, 6000);
}

function endGame(){
  gameActive = false;
  item = null;
  document.getElementById('hud').classList.add('hidden');
  const total = correctCount + wrongAttempts;
  const acc = total>0 ? Math.round((correctCount/total)*100) : 100;
  document.getElementById('endScore').textContent = score;
  document.getElementById('endAccuracy').textContent = acc + '%';
  showScreen('screenEnd');
}

/* ---------------- Screen management ---------------- */
function showScreen(id){
  ['screenStart','screenInstructions','screenEnd'].forEach(s=>{
    document.getElementById(s).classList.toggle('hidden', s!==id);
  });
}

document.getElementById('btnEnter').addEventListener('click', ()=>{
  showScreen('screenInstructions');
  initCamera();
});

document.getElementById('btnStartGame').addEventListener('click', ()=>{
  if(!usingHandTracking) return; // gated: can't start without hand tracking
  document.querySelectorAll('.screen').forEach(s=>s.classList.add('hidden'));
  document.getElementById('hintBanner').style.opacity = '1';
  startPlaythrough();
});

document.getElementById('btnRetryCam').addEventListener('click', ()=>{
  initCamera();
});

document.getElementById('btnReplay').addEventListener('click', ()=>{
  document.querySelectorAll('.screen').forEach(s=>s.classList.add('hidden'));
  document.getElementById('hintBanner').style.opacity = '1';
  startPlaythrough();
});

document.getElementById('btnHome').addEventListener('click', ()=>{
  showScreen('screenStart');
});

resizeCanvases();

/* ---------------- MediaPipe Hands setup ---------------- */
const videoEl = document.getElementById('cameraFeed');
let handsModel = null;
let mpCamera = null;
let lastHandSeen = 0;

function setCamStatus(state, text){
  const dot = document.getElementById('camStatusDot');
  const label = document.getElementById('camStatusText');
  label.textContent = text;
  dot.className = 'w-2 h-2 rounded-full ' + (
    state==='ok' ? 'bg-[var(--green)] pulse-dot' :
    state==='warn' ? 'bg-[var(--amber)]' :
    state==='bad' ? 'bg-[var(--rose)]' : 'bg-[var(--ink-dim)]'
  );

  const startBtn = document.getElementById('btnStartGame');
  const retryBtn = document.getElementById('btnRetryCam');
  const errorBox = document.getElementById('camErrorBox');

  if(state==='ok'){
    startBtn.disabled = false;
    startBtn.textContent = 'เริ่มเกม!';
    startBtn.className = 'btn-primary w-full py-4 rounded-2xl text-lg';
    retryBtn.classList.add('hidden');
    errorBox.classList.add('hidden');
  } else if(state==='bad'){
    startBtn.disabled = true;
    startBtn.textContent = 'ต้องเชื่อมกล้องก่อนถึงจะเริ่มได้';
    startBtn.className = 'w-full py-4 rounded-2xl text-lg opacity-40 cursor-not-allowed';
    startBtn.style.background = 'rgba(255,255,255,0.08)';
    startBtn.style.color = 'var(--ink-dim)';
    retryBtn.classList.remove('hidden');
    errorBox.classList.remove('hidden');
  } else {
    startBtn.disabled = true;
    startBtn.textContent = 'รอกล้องพร้อม...';
    startBtn.className = 'w-full py-4 rounded-2xl text-lg opacity-40 cursor-not-allowed';
    startBtn.style.background = 'rgba(255,255,255,0.08)';
    startBtn.style.color = 'var(--ink-dim)';
    retryBtn.classList.add('hidden');
    errorBox.classList.add('hidden');
  }
}

function updateModeBadge(){
  const b = document.getElementById('modeBadge');
  b.textContent = 'AR HAND MODE';
  b.style.color = 'var(--green)';
}

function dist(a,b){ return Math.hypot(a.x-b.x, a.y-b.y); }

function onHandResults(results){
  hctx.clearRect(0,0,innerWidth,innerHeight);

  if(!results.multiHandLandmarks || results.multiHandLandmarks.length===0){
    if(performance.now() - lastHandSeen > 900){
      pointer.active = false;
    }
    return;
  }

  lastHandSeen = performance.now();
  const landmarks = results.multiHandLandmarks[0];

  // draw full hand skeleton (mirrored to match video)
  drawHandSkeleton(landmarks);

  const indexTip = landmarks[8];
  const thumbTip = landmarks[4];

  // mirror x because video is mirrored
  const ix = (1 - indexTip.x) * innerWidth;
  const iy = indexTip.y * innerHeight;

  pointer.x = ix; pointer.y = iy; pointer.active = true; pointer.source='hand';

  const pinchDist = dist(indexTip, thumbTip);
  pointer.pinching = pinchDist < 0.06;

  if(!usingHandTracking){
    usingHandTracking = true;
    updateModeBadge();
  }
}

const HAND_CONNECTIONS = [
  [0,1],[1,2],[2,3],[3,4],
  [0,5],[5,6],[6,7],[7,8],
  [0,9],[9,10],[10,11],[11,12],
  [0,13],[13,14],[14,15],[15,16],
  [0,17],[17,18],[18,19],[19,20],
  [5,9],[9,13],[13,17]
];

function drawHandSkeleton(landmarks){
  hctx.save();
  hctx.strokeStyle = 'rgba(34,211,238,0.55)';
  hctx.lineWidth = 2;
  HAND_CONNECTIONS.forEach(([a,b])=>{
    const p1 = landmarks[a], p2 = landmarks[b];
    hctx.beginPath();
    hctx.moveTo((1-p1.x)*innerWidth, p1.y*innerHeight);
    hctx.lineTo((1-p2.x)*innerWidth, p2.y*innerHeight);
    hctx.stroke();
  });
  landmarks.forEach((p,i)=>{
    const x=(1-p.x)*innerWidth, y=p.y*innerHeight;
    hctx.beginPath();
    hctx.arc(x,y, i===8?6:3.5, 0, Math.PI*2);
    hctx.fillStyle = i===8 ? '#FBBF24' : 'rgba(231,236,245,0.85)';
    hctx.fill();
  });
  hctx.restore();
}

async function initCamera(){
  setCamStatus('warn','กำลังขอสิทธิ์เข้าถึงกล้อง...');
  document.getElementById('camErrorBox').classList.add('hidden');

  if(location.protocol === 'file:'){
    setCamStatus('bad','ไม่สามารถเปิดกล้องได้ (ไฟล์ถูกเปิดแบบ file://)');
    document.getElementById('camErrorDetail').textContent =
      'เบราว์เซอร์บล็อกกล้องเสมอเมื่อเปิดไฟล์ HTML โดยตรงแบบนี้ ต้องรันผ่าน local server (เช่น python3 -m http.server) แล้วเข้าผ่าน http://localhost:... เท่านั้น';
    return;
  }

  if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
    setCamStatus('bad','เบราว์เซอร์นี้ไม่รองรับกล้อง');
    document.getElementById('camErrorDetail').textContent =
      'ลองเปลี่ยนไปใช้ Chrome, Edge หรือ Safari เวอร์ชันล่าสุด';
    return;
  }

  // Libraries load from CDN as classic <script> tags; on a slow connection they
  // may not be attached to window yet even after DOMContentLoaded. Wait briefly.
  let waited = 0;
  while((typeof Hands === 'undefined' || typeof Camera === 'undefined') && waited < 4000){
    await new Promise(r => setTimeout(r, 200));
    waited += 200;
  }

  if(typeof Hands === 'undefined' || typeof Camera === 'undefined'){
    setCamStatus('bad','โหลดไลบรารีตรวจจับมือไม่สำเร็จ');
    document.getElementById('camErrorDetail').textContent =
      'โหลดจาก cdn.jsdelivr.net ไม่สำเร็จ — ตรวจสอบอินเทอร์เน็ต หรือลองปิด Ad-blocker/VPN แล้วกด "ลองเชื่อมกล้องอีกครั้ง"';
    return;
  }

  try{
    handsModel = new Hands({
      locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`
    });
    handsModel.setOptions({
      maxNumHands: 1,
      modelComplexity: 1,
      minDetectionConfidence: 0.6,
      minTrackingConfidence: 0.5
    });
    handsModel.onResults(onHandResults);

    mpCamera = new Camera(videoEl, {
      onFrame: async () => {
        try{ await handsModel.send({image: videoEl}); }catch(e){ /* ignore transient frame errs */ }
      },
      width: 640,
      height: 480
    });

    await mpCamera.start();
    videoEl.classList.remove('hidden');
    document.getElementById('fallbackBg').style.opacity = '0.0';
    usingHandTracking = true;
    updateModeBadge();
    setCamStatus('ok','พบกล้องแล้ว — ยกมือขึ้นให้เห็นในเฟรม');
  } catch(err){
    console.warn('Camera/hand tracking unavailable:', err);
    let detail = 'ไม่พบกล้อง หรือถูกปฏิเสธสิทธิ์เข้าถึง';
    if(err && err.name === 'NotAllowedError'){
      detail = 'คุณปฏิเสธสิทธิ์เข้าถึงกล้อง — กดไอคอนกล้อง/แม่กุญแจที่แถบ URL แล้วอนุญาตใหม่ แล้วกด "ลองเชื่อมกล้องอีกครั้ง"';
    } else if(err && err.name === 'NotFoundError'){
      detail = 'ไม่พบอุปกรณ์กล้องในเครื่อง — ตรวจสอบว่าเสียบ/เปิดกล้องอยู่';
    } else if(err && err.name === 'NotReadableError'){
      detail = 'กล้องถูกใช้งานโดยแอปอื่นอยู่ — ปิดแอปอื่นที่ใช้กล้อง (เช่น Zoom, Teams) แล้วลองใหม่';
    }
    setCamStatus('bad','เปิดกล้องไม่สำเร็จ');
    document.getElementById('camErrorDetail').textContent = detail;
  }
}

updateModeBadge();
</script>
